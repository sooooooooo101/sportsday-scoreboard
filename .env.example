# Firebase Web アプリの設定（Firebase コンソール → プロジェクトの設定 → マイアプリ）
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# 得点係アカウントのメールアドレス（合言葉 = このアカウントのパスワード）
VITE_SCORER_EMAIL=
# ローカル開発でエミュレーターに接続するとき true
VITE_USE_EMULATOR=false
# 得点係ユーザーの UID（Firebase コンソール → Authentication → ユーザー）。デプロイ時にルールへ差し込む。画面には埋め込まれない
SCORER_UID=
# 管理画面の秘密のパス（小文字英数字 24〜64 文字。例: openssl rand -hex 16）。URL は https://<プロジェクト>.web.app/<ADMIN_PATH>/
ADMIN_PATH=
